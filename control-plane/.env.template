BASE_URL=http://localhost:3000
NEXT_PUBLIC_DOMAIN=
CUSTOM_DOMAIN_CNAME_TARGET=

DATABASE_URL=
# Postgres connections per control-plane process (default 20). The whole
# control plane shares this pool, including the public site-data API.
DATABASE_POOL_MAX=
# Set to 1 ONLY behind an ingress that overwrites CF-Connecting-IP and blocks
# direct access. It selects the per-IP bucket for public write limits, and
# deploy.sh reads it to key the gateway's rate limits the same way.
SITE_DATA_TRUST_CLOUDFLARE_IP=
# Site databases live in the edge Worker. Both settings are required.
# Production origin: https://edge.naru.pub. The secret must match
# `wrangler secret put EDGE_WORKER_SECRET` in edge/.
EDGE_WORKER_URL=
EDGE_WORKER_SECRET=

S3_BUCKET_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

R2_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_USER_API_TOKEN=

RESEND_API_KEY=

# Toss Payments (recurring donation/billing). Use test keys in dev.
# Client keys are read server-side and passed to the browser (public).
# Toss issues separate MID/key pairs for automatic billing and general payments.
TOSS_BILLING_CLIENT_KEY=
TOSS_BILLING_SECRET_KEY=
TOSS_PAYMENT_CLIENT_KEY=
TOSS_PAYMENT_SECRET_KEY=
